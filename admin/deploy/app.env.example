# Hevyfin Admin settings. Copy to /srv/hevyfin-admin/app.env (chmod 600) and fill in.
# Only SECRET_KEY and JELLYFIN_URL are needed; every other service is optional and its part of
# the panel stays off while its URL is empty. From inside the container, the host is
# host.containers.internal (podman) or host.docker.internal (docker).

# Signs the panel's session cookie: any long random string (install.sh makes one).
SECRET_KEY=
JELLYFIN_URL=http://host.containers.internal:8096

# Requests tab (and adding people to Seerr).
SEERR_URL=
SEERR_KEY=

# Server health: missing titles, queues, disk space, freeing up space.
SONARR_URL=
SONARR_KEY=
RADARR_URL=
RADARR_KEY=
# Only disks under this path are shown in Space (e.g. /data). Empty shows them all.
MEDIA_ROOT=

# Download tools: off unless set. Only use them for content you have the right to download.
PROWLARR_URL=
PROWLARR_KEY=
QBIT_URL=
QBIT_USER=
QBIT_PASS=
